{isMobileMenuOpen ? '收起导航菜单' : '展开导航菜单'}\n            onClick={handleMobileMenuToggle}\n          >\n            {isMobileMenuOpen ? '关闭' : '菜单'}\n          </button>\n\n          <nav className=\"hidden md:block\" aria-label=\"主导航\">\n            <ul className=\"flex items-center gap-6\">\n              {content.navigation.map((item) => (\n                <li key={item.href}>\n                  <a\n                    href={item.href}\n                    className=\"text-sm text-slate-300 outline-none transition hover:text-white focus-visible:rounded-md focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950\"\n                  >\n                    {item.label}\n                  </a>\n                </li>\n              ))}\n            </ul>\n          </nav>\n        </div>\n\n        {isMobileMenuOpen ? (\n          <nav\n            id=\"mobile-navigation\"\n            className=\"border-t border-slate-800 px-6 py-4 md:hidden\"\n            aria-label=\"移动端导航\"\n          >\n            <ul className=\"flex flex-col gap-3\">\n              {content.navigation.map((item) => (\n                <li key={item.href}>\n                  <a\n                    href={item.href}\n                    className=\"block rounded-md px-2 py-2 text-sm text-slate-200 outline-none transition hover:bg-slate-900 hover:text-white focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950\"\n                    onClick={handleNavLinkClick}\n                  >\n                    {item.label}\n                  </a>\n                </li>\n              ))}\n            </ul>\n          </nav>\n        ) : null}\n      </header>\n\n      <main id=\"top\">\n        <section className=\"mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-24\">\n          <div className=\"max-w-3xl\">\n            <p className=\"inline-flex rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-1 text-sm font-medium text-emerald-300\">\n              {content.hero.badge}\n            </p>\n            <h1 className=\"mt-6 text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl\">\n              {content.hero.title}\n            </h1>\n            <p className=\"mt-4 text-xl text-slate-200\">{content.hero.subtitle}</p>\n            <p className=\"mt-6 max-w-2xl text-base leading-7 text-slate-300\">\n              {content.hero.description}\n            </p>\n            <div className=\"mt-8 flex flex-col gap-4 sm:flex-row\">\n              <a\n                href={content.hero.cta.primaryHref}\n                className=\"inline-flex items-center justify-center rounded-md bg-emerald-500 px-5 py-3 text-sm font-semibold text-slate-950 outline-none transition hover:bg-emerald-400 focus-visible:ring-2 focus-visible:ring-emerald-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950\"\n              >\n                {content.hero.cta.primaryText}\n              </a>\n              <a\n                href={content.hero.cta.secondaryHref}\n                className=\"inline-flex items-center justify-center rounded-md border border-slate-700 px-5 py-3 text-sm font-semibold text-slate-100 outline-none transition hover:border-slate-500 hover:bg-slate-900 focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950\"\n              >\n                {content.hero.cta.secondaryText}\n              </a>\n            </div>\n          </div>\n        </section>\n\n        <section id=\"features\" className=\"mx-auto max-w-7xl px-6 py-16 lg:px-8\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-3xl font-bold tracking-tight text-white\">产品功能</h2>\n            <p className=\"mt-4 text-base leading-7 text-slate-300\">\n              围绕糖尿病日常管理中的记录、提醒、分析与执行场景，帮助用户建立更稳定的控糖流程。\n            </p>\n          </div>\n          <div className=\"mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3\">\n            {content.features.map((feature) => (\n              <article\n                key={feature.title}\n                className=\"rounded-2xl border border-slate-800 bg-slate-900/60 p-6 shadow-sm shadow-black/20\"\n              >\n                <p className=\"text-sm font-medium text-emerald-300\">{feature.highlight}</p>\n                <h3 className=\"mt-3 text-xl font-semibold text-white\">{feature.title}</h3>\n                <p className=\"mt-4 text-sm leading-7 text-slate-300\">{feature.description}</p>\n              </article>\n            ))}\n          </div>\n        </section>\n\n        <section id=\"pricing\" className=\"mx-auto max-w-7xl px-6 py-16 lg:px-8\">\n          <div className=\"rounded-3xl border border-dashed border-slate-700 bg-slate-900/40 p-8 lg:p-10\">\n            <h2 className=\"text-3xl font-bold tracking-tight text-white\">{content.pricing.title}</h2>\n            <p className=\"mt-4 max-w-3xl text-base leading-7 text-slate-300\">\n              {content.pricing.description}\n            </p>\n            <p className=\"mt-4 text-sm leading-6 text-slate-400\">{content.pricing.note}</p>\n            <div className=\"mt-8\">\n              <a\n                href=\"#contact\"\n                className=\"inline-flex items-center justify-center rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-950 outline-none transition hover:bg-slate-200 focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950\"\n              >\n                {content.pricing.ctaText}\n              </a>\n            </div>\n          </div>\n        </section>\n\n        <section id=\"faq\" className=\"mx-auto max-w-7xl px-6 py-16 lg:px-8\">\n          <div className=\"max-w-3xl\">\n            <h2 className=\"text-3xl font-bold tracking-tight text-white\">{content.faq.title}</h2>\n            <p className=\"mt-4 text-base leading-7 text-slate-300\">{content.faq.description}</p>\n          </div>\n          <div className=\"mt-8 grid gap-6 lg:grid-cols-2\">\n            <article className=\"rounded-2xl border border-slate-800 bg-slate-900/60 p-6\">\n              <h3 className=\"text-lg font-semibold text-white\">{content.faq.questionPlaceholder}</h3>\n              <p className=\"mt-3 text-sm leading-7 text-slate-300\">{content.faq.answerPlaceholder}</p>\n            </article>\n            <aside className=\"rounded-2xl border border-dashed border-slate-700 bg-slate-900/40 p-6\">\n              <p className=\"text-sm leading-7 text-slate-400\">{content.faq.note}</p>\n            </aside>\n          </div>\n        </section>\n\n        <section className=\"mx-auto max-w-7xl px-6 py-16 lg:px-8\">\n          <div className=\"rounded-3xl border border-emerald-500/20 bg-emerald-500/10 p-8 lg:flex lg:items-center lg:justify-between lg:gap-8\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-bold tracking-tight text-white\">准备开始更系统的控糖管理？</h2>\n              <p className=\"mt-4 text-base leading-7 text-slate-200\">\n                通过演示了解产品如何支持个人、家庭和健康管理团队协同推进日常管理。\n              </p>\n            </div>\n            <div className=\"mt-8 flex flex-col gap-4 sm:flex-row lg:mt-0\">\n              <a\n                href={content.secondaryCta.primaryHref}\n                className=\"inline-flex items-center justify-center rounded-md bg-emerald-400 px-5 py-3 text-sm font-semibold text-slate-950 outline-none transition hover:bg-emerald-300 focus-visible:ring-2 focus-visible:ring-emerald-200 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950\"\n              >\n                {content.secondaryCta.primaryText}\n              </a>\n              <a\n                href={content.secondaryCta.secondaryHref}\n                className=\"inline-flex items-center justify-center rounded-md border border-emerald-200/30 px-5 py-3 text-sm font-semibold text-white outline-none transition hover:bg-white/5 focus-visible:ring-2 focus-visible:ring-emerald-200 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950\"\n              >\n                {content.secondaryCta.secondaryText}\n              </a>\n            </div>\n          </div>\n        </section>\n      </main>\n\n      <footer id=\"contact\" className=\"border-t border-slate-800\">\n        <div className=\"mx-auto grid max-w-7xl gap-10 px-6 py-12 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:px-8\">\n          <div>\n            <h2 className=\"text-2xl font-semibold text-white\">{content.productName}</h2>\n            <p className=\"mt-4 max-w-2xl text-sm leading-7 text-slate-300\">{content.footer.text}</p>\n          </div>\n          <nav aria-label=\"页脚联系信息\">\n            <ul className=\"space-y-4\">\n              {content.footer.contacts.map((contact) => (\n                <li key={contact.label} className=\"rounded-xl border border-slate-800 bg-slate-900/40 px-4 py-3\">\n                  <p className=\"text-xs font-medium uppercase tracking-wide text-slate-400\">\n                    {contact.label}\n                  </p>\n                  <p className=\"mt-1 text-sm text-slate-100\">{contact.value}</p>\n                </li>\n              ))}\n            </ul>\n          </nav>\n        </div>\n      </footer>\n    </div>\n  );\n}\n","path":".shipyard/projects/proj-1778567753301/sessions/sess-1778567753303/output/src/App.tsx"},"output":"Written: .shipyard/projects/proj-1778567753301/sessions/sess-1778567753303/output/src/App.tsx (213 lines)","success":true,"timestamp":"2026-05-12T06:59:35.103Z"}],"verifications":[{"type":"compile","passed":true,"output":"1 file(s) compiled","durationMs":370,"timestamp":"2026-05-12T06:51:17.045Z"}]},"opId":"bcb52ce5-5d96-487c-bbbb-317dd7db4818","at":"2026-05-12T06:59:35.103Z","sessionRevision":1}
