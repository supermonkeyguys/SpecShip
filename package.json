{
  "name": "shipyard",
  "private": true,
  "version": "0.1.0",
  "description": "AI-driven code generation harness — spec in, code out",
  "packageManager": "pnpm@9.0.0+sha512.b4106707c7225b1748b61595953ccbebff97b54ad05d002aa3635f633b9c53cd666f7ce9b8bc44704f1fa048b9a49b55371ab2d9e9d667d1efe2ef1514bcd513",
  "scripts": {
    "test": "node --require tsx/cjs --test test/math.test.ts test/regression/run-basic.test.ts test/regression/retry.test.ts test/regression/resume.test.ts test/regression/manual-retry.test.ts test/regression/checkpoint.test.ts test/regression/repo-context.test.ts test/regression/op-events.test.ts test/regression/node-change.test.ts",
    "test:regression": "node --require tsx/cjs --test test/regression/run-basic.test.ts test/regression/retry.test.ts test/regression/resume.test.ts test/regression/manual-retry.test.ts test/regression/op-events.test.ts",
    "start": "ts-node apps/cli/src/index.ts",
    "dev": "node ./scripts/dev-default.mjs",
    "dev:go": "node ./scripts/dev-default.mjs",
    "dev:ts": "turbo run dev --filter=@shipyard/server --filter=@shipyard/web",
    "server": "pnpm --dir apps/server-go dev",
    "server:go": "pnpm --dir apps/server-go dev",
    "server:go:build": "pnpm --dir apps/server-go build",
    "server:go:test": "pnpm --dir apps/server-go test",
    "server:ts": "pnpm --filter @shipyard/server dev",
    "server:dev": "pnpm server:go",
    "server:ts:typecheck": "pnpm --filter @shipyard/server exec tsc -p tsconfig.json --noEmit",
    "web:dev": "pnpm --filter @shipyard/web dev",
    "web:build": "pnpm --filter @shipyard/web build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli:dev": "ts-node apps/cli/src/index.ts",
    "build": "pnpm server:go:build && turbo run build --filter=@shipyard/web --filter=@shipyard/server",
    "web:lint": "pnpm --filter @shipyard/web lint",
    "server:typecheck": "pnpm server:ts:typecheck",
    "quality:web": "pnpm web:lint && pnpm web:build",
    "quality:server": "pnpm server:go:test && pnpm server:go:build",
    "quality:server:ts": "pnpm server:ts:typecheck",
    "quality": "pnpm quality:server && pnpm quality:server:ts && pnpm quality:web",
    "temporal:server": "temporal server start-dev",
    "temporal:worker": "tsx packages/orchestrator-temporal/src/worker/worker.ts",
    "temporal:all": "concurrently \"pnpm temporal:server\" \"sleep 2 && pnpm temporal:worker\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.119",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "turbo": "^2.5.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "@emnapi/core": "1.9.2"
    }
  }
}
